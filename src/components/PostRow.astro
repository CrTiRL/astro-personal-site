---
import type { CollectionEntry } from 'astro:content';
import { dateLabel } from '../lib/content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
---
<a class="post-row" href={`/blog/${post.id}/`}><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><div><div class="tags">{post.data.tags.map(t => <span>{t}</span>)}</div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="post-arrow" aria-hidden="true">↗</span></a>
