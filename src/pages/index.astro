---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import { posts, projects } from '../lib/content';
import { site } from '../site';
const articles = await posts(); const works = await projects();
---
<Base>
  <section class="hero">
    <div class="hero-copy"><p class="eyebrow"><span class="dot"></span> A PERSONAL SPACE FOR IDEAS</p><h1>保持好奇，<br />慢慢<span class="serif accent">创造。</span></h1><p class="hero-desc">你好，我是{site.name}。<br />在这里记录学习的过程，分享认真做过的东西。<br />关于技术、设计，以及生活里的微小发现。</p><div class="hero-actions"><a class="button" href="/projects/">看看我的作品 <span>↗</span></a><a class="text-link" href="/about/">认识我 <span>→</span></a></div><p class="demo-note">个人主题模板 · 姓名与内容为待替换示例</p></div>
    <div class="hero-art" role="img" aria-label="抽象山丘、太阳与纸张组成的绿色风景插画"><div class="art-label">FIELD NOTES<br /><span>观察 / 记录 / 创造</span></div><div class="sun"></div><div class="hill hill-back"></div><div class="hill hill-front"></div><div class="art-lines"></div><div class="art-coordinate">IDEAS TAKE ROOT HERE.</div><span class="art-star">✳</span></div>
  </section>
  <div class="intro-strip"><span>用文字整理思路，用作品回应好奇。</span><span class="eyebrow">LEARN. MAKE. REPEAT. ↙</span></div>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>把想法，变成作品<span class="accent">。</span></h2></div><a class="text-link" href="/projects/">全部作品 ↗</a></div><div class="project-grid">{works.slice(0,2).map((project,index) => <ProjectCard project={project} index={index} />)}</div></section>
  <section class="section"><div class="section-heading"><div><p class="eyebrow">02 / RECENT WRITING</p><h2>最近在想些什么<span class="accent">。</span></h2></div><a class="text-link" href="/blog/">全部文章 ↗</a></div><div class="post-list">{articles.slice(0,3).map(post => <PostRow post={post} />)}</div></section>
  <section class="about-band"><span class="asterisk" aria-hidden="true">✳</span><div><p class="eyebrow">A LITTLE MORE ABOUT ME</p><h2>在持续学习中，<br />找到自己的节奏。</h2><p>这个空间会随着新的尝试慢慢生长。<br />愿每一次记录，都让下一步更清晰。</p></div><a class="button outline" href="/about/">关于我 ↗</a></section>
</Base>
