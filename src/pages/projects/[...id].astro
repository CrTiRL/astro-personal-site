---
import { render } from 'astro:content'; import Base from '../../layouts/Base.astro'; import { projects } from '../../lib/content';
export async function getStaticPaths() { return (await projects()).map(project => ({params: {id:project.id}, props:{project}})); }
const {project} = Astro.props; const {Content} = await render(project);
---
<Base title={project.data.title} description={project.data.description}><article class="article"><a class="text-link" href="/projects/">← 返回作品</a><header class="article-header"><p class="eyebrow">{project.data.type} / 示例项目</p><h1>{project.data.title}</h1><p>{project.data.description}</p><div class="tags">{project.data.tags.map(tag => <span>{tag}</span>)}</div>{project.data.url && <a class="button" href={project.data.url}>访问项目 ↗</a>}</header><div class="prose"><Content /></div></article></Base>
