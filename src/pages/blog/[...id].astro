---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { posts, dateLabel } from '../../lib/content';
export async function getStaticPaths() { return (await posts()).map(post => ({ params: {id: post.id}, props: {post} })); }
const { post } = Astro.props; const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}><article class="article"><a class="text-link" href="/blog/">← 返回文章</a><header class="article-header"><p class="eyebrow">{dateLabel(post.data.date)} · 示例文章</p><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header><div class="prose"><Content /></div><div class="article-end">✳<p>感谢阅读，下一篇见。</p><a class="text-link" href="/blog/">继续阅读 →</a></div></article></Base>
